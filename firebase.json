{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "package.json",
      "package-lock.json",
      "node_modules/**",
      ".env*",
      "server/**",
      "functions/**",
      "*.md",
      "*.zip"
    ],
    "rewrites": [
      { "source": "/", "destination": "/login.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
